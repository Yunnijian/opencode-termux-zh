#!/data/data/com.termux/files/usr/bin/bash
set -o pipefail
export OPENCODE_DISABLE_AUTOUPDATE=1

if [ -z "${PREFIX:-}" ]; then
  if [ -d /data/user/0/com.termux/files/usr ]; then
    export PREFIX=/data/user/0/com.termux/files/usr
  else
    export PREFIX=/data/data/com.termux/files/usr
  fi
fi
export HOME="${HOME:-$(dirname "$PREFIX")/home}"
export PATH="$PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$PREFIX/lib"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMPDIR"

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
source "$DIR/scripts/termux-mouse-default.sh"
opencode_termux_default_mouse
OPENCODE_DIR="$HOME/.opencode"
CURRENT="$(node -e 'console.log(require(process.argv[1]).version)' "$DIR/package.json" 2>/dev/null)"
INSTALLED_VERSION="$(cat "$OPENCODE_DIR/.opencode-termux-version" 2>/dev/null || true)"

install_opencode() {
  node "$DIR/install.js"
}

if [ ! -f "$PREFIX/etc/tls/cert.pem" ] || [ ! -f "$PREFIX/etc/resolv.conf" ] || ! command -v timeout >/dev/null 2>&1; then
  node "$DIR/install.js" --ensure-dependencies || exit $?
fi

if [ ! -f "$OPENCODE_DIR/opencode" ] || [ ! -f "$OPENCODE_DIR/ld-musl-aarch64.so.1" ] || [ ! -f "$OPENCODE_DIR/libc.musl-aarch64.so.1" ] || [ ! -f "$OPENCODE_DIR/libgcc_s.so.1" ] || [ ! -f "$OPENCODE_DIR/libstdc++.so.6" ] || [ ! -f "$OPENCODE_DIR/libstdc++.so.6.0.33" ] || [ "$CURRENT" != "$INSTALLED_VERSION" ]; then
  install_opencode || exit $?
fi

export LD_PRELOAD="$OPENCODE_DIR/ld-musl-aarch64.so.1"
export LD_LIBRARY_PATH="$OPENCODE_DIR:$LD_LIBRARY_PATH"
export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"

exec "$OPENCODE_DIR/opencode" "$@"
